{
  "name": "red-soil-outpost-7",
  "private": true,
  "version": "1.0.0",
  "description": "Red Soil: Outpost 7 - a pixel-art Mars survival, mining, farming and outpost engineering trainer for young learners. 2026 NASA Space Apps Challenge entry by SideLoaders.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "bash scripts/package.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.0",
    "@fontsource/vt323": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
